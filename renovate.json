{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edbfi/automation//default.json#v3.0.0",
    "customManagers:githubActionsVersions"
  ],
  "pep723": {
    "managerFilePatterns": [
      "/^server-scripts/backup/python/.*\\.py$/"
    ]
  },
  "automerge": false,
  "platformAutomerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    }
  ]
}
